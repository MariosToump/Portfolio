---
import { Image } from 'astro:assets';
import { roles, date, type Lang } from '../data/content';
import { siteCopy } from '../data/site';
import { developmentProjects } from '../data/development';
import portrait from '../assets/marios-portrait.png';
import SiteLayout from './SiteLayout.astro';
import ProjectCard from './ProjectCard.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = siteCopy[lang];
const recentRoles = roles.filter(role => ['accenture', 'telus', 'sovel-maintenance'].includes(role.id));
---
<SiteLayout lang={lang}>
  <section class="hero hero--split" data-enter aria-labelledby="name">
    <div class="intro"><p class="developer-title">{t.title}</p><h1 id="name">{t.name.split(' ').map((part, index) => <>{index > 0 && ' '}<span class="name-part">{part}</span></>)}</h1><p class="intro-text">{t.intro}</p><div class="actions"><a class="button primary" href="#projects">{t.explore}</a><a class="text-action" href={`/${lang}/experience/`}>{t.cv}</a></div></div>
    <div class="hero-side"><div class="hero-portrait" data-enter-media aria-hidden="true"><Image src={portrait} alt="" width={800} widths={[400, 640, 800]} sizes="(max-width: 700px) calc(100vw - 40px), 42vw" format="webp" quality={82} fetchpriority="high" loading="eager" /></div></div>
  </section>
  <section id="projects" class="section" aria-labelledby="projects-title"><div class="section-head"><h2 id="projects-title">{t.selected}</h2><p class="projects-intro">{t.workIntro}</p></div>{developmentProjects.map(project => <ProjectCard project={project} lang={lang} />)}</section>
  <section id="skills" class="section" aria-labelledby="skills-title"><h2 id="skills-title">{t.skills}</h2><div class="skill-list">{t.skillAreas.map(area => <div><h3>{area.title}</h3><p>{area.text}</p><a href={`/${lang}/work/${area.project}/`}>{area.link}</a></div>)}</div></section>
  <section id="experience" class="section" aria-labelledby="experience-title"><div class="section-head"><h2 id="experience-title">{t.background}</h2><p class="projects-intro">{t.backgroundIntro}</p></div><div class="relevant-work"><h3>{t.relevant}</h3><p>{t.relevantText}</p><a class="source-link" href={`/${lang}/work/factory-reporting/`}>{lang === 'en' ? 'Read the case study' : 'Δείτε το έργο'}</a></div><ul class="career-summary">{recentRoles.map(role => <li><p>{date(role.start, lang)} – {date(role.end, lang)}</p><div><h3>{role.title[lang]}</h3><p>{role.employer[lang]}</p></div></li>)}</ul><a class="source-link" href={`/${lang}/experience/`}>{t.fullCv}</a></section>
  <section id="about" class="section about-section" aria-labelledby="about-title"><h2 id="about-title">{t.aboutTitle}</h2><p>{t.aboutText}</p></section>
</SiteLayout>
