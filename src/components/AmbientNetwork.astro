// Original, still artwork. Small clusters suggest connected systems without
// adding a canvas, animation loop, pointer tracking or third-party assets.
const nodes = [
  [18,150],[115,106],[202,146],[168,246],[58,284],[260,310],[310,188],
  [32,456],[143,400],[224,474],[185,596],[66,640],[290,650],[340,530],
  [380,66],[488,110],[540,46],[598,174],[710,100],
  [1010,80],[1115,140],[1230,92],[1340,166],[1460,115],[1554,224],
  [1050,300],[1174,262],[1280,346],[1420,298],[1510,394],
  [1100,475],[1220,522],[1340,454],[1460,570],[1575,520],
  [1000,650],[1150,708],[1270,640],[1390,736],[1540,690],
  [26,822],[150,760],[262,848],[390,786],[510,884],
