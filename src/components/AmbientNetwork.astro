---
<div class="ambient-network" aria-hidden="true">
  <svg viewBox="0 0 1600 960" preserveAspectRatio="xMidYMin slice" fill="none" focusable="false">
    <g class="network-lines">{edges.map(([a,b]) => <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} />)}</g>
    <g class="network-nodes">{nodes.map(([x,y],i) => <circle cx={x} cy={y} r={i % 5 === 0 ? 2.8 : 1.8} />)}</g>
  </svg>
</div>
