---
interface Props { kind: string; class?: string }
const { kind, class: className = '' } = Astro.props;
---
<svg class:list={['role-icon', className]} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'accenture' && <><path d="M8 4h11l5 5v19H8zM19 4v6h5M12 14h8M12 18h5" /><path d="m12 23 2 2 5-5" /></>}
  {kind === 'telus' && <><path d="m16 3 11 4v8c0 7-7 12-11 14C12 27 5 22 5 15V7z" /><path d="m10 15 4 4 8-9" /></>}
  {kind === 'sovel-maintenance' && <><rect x="4" y="5" width="24" height="23" rx="3" /><path d="M4 12h24M12 12v16M17 17h6M17 22h6M8 17h.01M8 22h.01" /></>}
  {kind === 'sovel-web' && <><rect x="3" y="5" width="26" height="22" rx="3" /><path d="M3 12h26M8 9h.01M12 9h.01m-1 7-4 4 4 4m10-8 4 4-4 4m-3-9-4 10" /></>}
  {kind === 'cnc' && <><path d="M5 27h23M8 27V6h15v5H13v7M20 11v9m-4 0h8M6 22h21v5M18 4h7" /><path d="M20 20v2" /></>}
  {kind === 'other' && <><path d="m4 10 12-6 12 6-12 6zM4 10v14l12 6 12-6V10M16 16v14M10 7l12 6" /></>}
</svg>
