---
import type { DevelopmentProject } from '../data/development';
import type { Lang } from '../data/content';
import { siteCopy } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: DevelopmentProject; lang: Lang }
const { project, lang } = Astro.props;
const t = siteCopy[lang];
const href = `/${lang}/work/${project.id}/`;
---
<article class="project-entry" id={project.id}>
  <a class="project-preview-link" href={href} aria-label={`${t.details}: ${project.title[lang]}`}><ProjectVisual project={project} lang={lang} /></a>
  <div class="project-copy">
    <p class="project-category">{project.category[lang]}</p>
    <h3><a href={href}>{project.title[lang]}</a></h3>
    <p class="project-status">{project.status[lang]}</p><p>{project.summary[lang]}</p>
    <p class="project-role">{project.role[lang]}</p>
    <ul class="project-tools" aria-label={lang === 'en' ? 'Technologies' : 'Τεχνολογίες'}>{project.tools.map(tool => <li>{tool}</li>)}</ul>
    <div class="project-links"><a class="source-link" href={href}>{t.details}</a>{project.url && <a class="source-link secondary-project-link" href={project.url}>{project.linkLabel?.[lang]}</a>}</div>
  </div>
</article>
